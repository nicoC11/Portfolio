---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import heroImage from '../assets/hero.png';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			:global(html) {
				scroll-behavior: smooth;
			}

			/* ---------- Hero ---------- */
			.hero {
				position: relative;
				height: 85svh;
				min-height: 480px;
				display: grid;
				place-items: center;
				text-align: center;
				overflow: hidden;
			}
			.hero :global(.hero-img) {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
			}
			.hero-overlay {
				position: absolute;
				inset: 0;
				background: linear-gradient(
					to bottom,
					color-mix(in srgb, var(--violet-background) 55%, transparent),
					var(--violet-background)
				);
			}
			.hero-content {
				position: relative;
				max-width: 720px;
				padding: 0 1.5rem;
				text-shadow: 0 2px 12px rgba(0, 0, 0, 0.6);
				animation: fade-up 1s ease both;
			}
			
			/* Violet glow on the title */
			.hero-content h1 {
				text-shadow:
					0 0 6px color-mix(in srgb, var(--violet) 45%, transparent),
					0 0 20px color-mix(in srgb, var(--violet-accent) 55%, transparent);
			}

			/* Blinking cursor after the title */
			.hero-content h1::after {
				content: '';
				display: inline-block;
				width: 0.08em;
				height: 0.8em;
				margin-left: 0.12em;
				vertical-align: -0.01em;
				background: var(--violet-light);
				box-shadow: 0 0 6px color-mix(in srgb, var(--violet) 60%, transparent),
							0 0 20px color-mix(in srgb, var(--violet-accent) 70%, transparent);
				animation: blink 1s step-end infinite;
			}
			@keyframes blink {
				50% {
					opacity: 0;
				}
			}

			.scroll-down {
				position: absolute;
				bottom: 2rem;
				left: 50%;
				transform: translateX(-50%);
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.6rem;
				color: var(--violet-text);
				text-decoration: none;
				font-size: 0.85rem;
				letter-spacing: 0.15em;
				text-transform: uppercase;
			}
			.chevron {
				width: 14px;
				height: 14px;
				border-right: 2px solid currentColor;
				border-bottom: 2px solid currentColor;
				transform: rotate(45deg);
				animation: bounce 1.6s ease-in-out infinite;
			}
			@keyframes bounce {
				0%,
				100% {
					transform: translateY(0) rotate(45deg);
					opacity: 0.4;
				}
				50% {
					transform: translateY(8px) rotate(45deg);
					opacity: 1;
				}
			}
			@keyframes fade-up {
				from {
					opacity: 0;
					transform: translateY(16px);
				}
				to {
					opacity: 1;
					transform: none;
				}
			}

			/* ---------- Posts ---------- */
			main {
				width: 960px;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: var(--black);
				line-height: 1;
			}
			.date {
				margin: 0;
				color: var(--gray);
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: var(--violet-light);
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				:global(html) {
					scroll-behavior: auto;
				}
				.hero-content,
				.chevron {
					animation: none;
				}
				.hero-content h1::after {
					animation: none;
				}
			}
		</style>
	</head>
	<body>
		<Header />

		<section class="hero">
			<Image
				class="hero-img"
				src={heroImage}
				alt=""
				widths={[800, 1400, 2000]}
				sizes="100vw"
				loading="eager"
			/>
			<div class="hero-overlay"></div>

			<div class="hero-content">
				<h1>Hi, I'm Nico</h1>
				<p>
					Computer engineer working across cloud, systems and robotics. This is where I document
					the projects I build, starting with this very site on AWS.{' '}
					<a href="/about">About me →</a>
				</p>
			</div>

			<a href="#posts" class="scroll-down" aria-label="Scroll down to the posts">
				<span>Scroll down</span>
				<span class="chevron"></span>
			</a>
		</section>

		<main id="posts">
			<section>
				<ul>
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								{post.data.heroImage && (
									<Image width={720} height={360} src={post.data.heroImage} alt="" />
								)}
								<h4 class="title">{post.data.title}</h4>
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
								</p>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>

		<Footer />
	</body>
</html>